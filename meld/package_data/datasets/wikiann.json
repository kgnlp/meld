{
    "WikiANN": {
        "citekeys": [
            "rahimi-etal-2019-massively",
            "pan-etal-2017-cross"
        ],
        "note": "Commonly used subset of the original version by Pan et al., 2017",
        "source": {
            "loader": "huggingface",
            "arguments": {
                "repo": "unimelb-nlp/wikiann",
                "revision": "f0a3be6dc5564c0cc4150bb660144800a1f539d4",
                "fast_subset_load": true,
                "language_from_subset_name": "(?P<language>.+)",
                "text_column": "tokens",
                "tag_column": "ner_tags",
                "train_name": "train",
                "validation_name": "validation",
                "test_name": "test",
                "data_pipe": [
                    {
                        "step": "columns",
                        "detokenizer_type": "wikiann",
                        "tagsets": {
                            "ner": {
                                "label_map": {
                                    "O": 0,
                                    "B-PER": 1,
                                    "I-PER": 2,
                                    "B-ORG": 3,
                                    "I-ORG": 4,
                                    "B-LOC": 5,
                                    "I-LOC": 6
                                }
                            }
                        }
                    }
                ]
            }
        },
        "format": {
            "text": "pre-tokenized",
            "token_format": "wikiann",
            "tags": "bio",
            "tag_format": "indices"
        },
        "metadata": [
            {
                "split": [],
                "license": "Unspecified",
                "document_boundaries": "none",
                "sentence_boundaries": "full",
                "annotation": {
                    "type": "silver-standard",
                    "annotator_count": null,
                    "features": [
                        "automatically-extracted"
                    ],
                    "agreement": null
                },
                "primary_domain": "wikipedia",
                "other_domains": [],
                "finegrained_domains": [],
                "data_sources": [
                    "Wikipedia"
                ],
                "dataset_lineage": [
                    "Wikiann (subset of the original 282 language dataset)"
                ],
                "label_set_standard": null
            }
        ]
    }
}
