{
    "idner-news-2k": {
        "citekeys": [
            "khairunnisa2020"
        ],
        "source": {
            "loader": "git",
            "arguments": {
                "repo": "https://github.com/khairunnisaor/idner-news-2k.git",
                "revision": "625ff40f85b03c615c036ef11bc23cb70c79987a",
                "base_language": "ind",
                "default_data_pipe": [
                    {
                        "step": "convert",
                        "reader": {
                            "type": "conll",
                            "arguments": {
                                "dialect": "conll_with_pos",
                                "delimiter": " "
                            }
                        }
                    }
                ],
                "subsets": {
                    "__root__": {
                        "train": [
                            "train.txt"
                        ],
                        "validation": [
                            "dev.txt"
                        ],
                        "test": [
                            "test.txt"
                        ]
                    }
                }
            }
        },
        "format": {
            "text": "pre-tokenized",
            "tags": "bio"
        },
        "metadata": [
            {
                "split": [],
                "license": "MIT",
                "document_boundaries": "none",
                "sentence_boundaries": "full",
                "annotation": {
                    "type": "gold-standard",
                    "annotator_count": 3,
                    "features": [],
                    "agreement": {
                        "metric": "fleiss-kappa",
                        "value": 0.92
                    }
                },
                "primary_domain": "news",
                "other_domains": [],
                "finegrained_domains": [],
                "data_sources": [
                    {
                        "source": "Kompas",
                        "url": "https://www.kompas.com/"
                    },
                    {
                        "source": "Tempo",
                        "url": "https://www.tempo.co/"
                    },
                    {
                        "source": "Tribun News",
                        "url": "https://www.tribunnews.com/"
                    }
                ],
                "dataset_lineage": [
                    "Indonesia-NER"
                ],
                "label_set_standard": null
            }
        ]
    }
}
