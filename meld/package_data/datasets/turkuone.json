                    "features": [],
                    "agreement": null
                },
                "primary_domain": "general",
                "other_domains": [
                    "wikipedia",
                    "news",
                    "speeches",
                    "literature",
                    "EU legislation",
                    "Finnish legislation"
                ],
                "finegrained_domains": [],
                "data_sources": [
                    "FiNER data",
                    "Turku NER Corpus data",
                    {
                        "source": "Finnish Acts of Parliament (60 acts and decrees)",
