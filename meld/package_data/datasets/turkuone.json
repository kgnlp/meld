                        "validation": [
                            "dev.tsv"
                        ],
                        "test": [
                            "test.tsv"
                        ]
                    }
                }
            }
        },
        "format": {
            "text": "pre-tokenized",
            "tags": "bio"
        },
        "metadata": [
            {
                "split": [],
                "license": {
                    "annotations": "CC BY-SA 4.0",
                    "text": {
                        "Digitoday": "CC BY-ND-NC 1.0",
