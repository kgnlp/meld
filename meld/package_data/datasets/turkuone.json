{
    "TurkuONE": {
        "citekeys": [
            "luoma-etal-2021-fine"
        ],
        "source": {
            "loader": "git",
            "arguments": {
                "repo": "https://github.com/TurkuNLP/turku-one.git",
                "revision": "6df48238c521c6e4618b3c117412fb56d0ccbf58",
                "base_language": "fin",
                "default_data_pipe": [
                    {
                        "step": "convert",
                        "reader": {
                            "type": "conll"
                        }
                    }
                ],
                "subsets": {
                    "__root__": {
                        "directory": "data/conll",
                        "train": [
                            "train.tsv"
