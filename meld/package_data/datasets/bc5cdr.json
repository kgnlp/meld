                    }
                }
            },
            {
                "split": [
                    ".validation"
                ],
                "annotation": {
                    "agreement": {
                        "metric": "jaccard-score",
                        "value": {
                            "Disease": "0.8742",
                            "Chemical": "0.9577"
                        }
                    }
                }
            },
            {
                "split": [
                    ".test"
                ],
                "annotation": {
                    "agreement": {
                        "metric": "jaccard-score",
                        "value": {
                            "Disease": "0.8875",
                            "Chemical": "0.9630"
                        }
                    }
                }
            }
