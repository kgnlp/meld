                    }
                },
                "primary_domain": "biomedical",
                "other_domains": [],
                "finegrained_domains": [
                    "chemical",
                    "structure associated chemical entity mentions (SACEMs)"
                ],
                "data_sources": [
                    "PubMed"
                ],
                "dataset_lineage": [],
                "label_set_standard": null
            }
        ]
    }
}
