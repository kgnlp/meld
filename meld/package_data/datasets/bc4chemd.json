                "revision": "df0df02fae6dbb87d88ffcf323b9096528f06f84",
                "keep_repo": true,
                "base_language": "eng",
                "subsets": {
                    "__root__": {
                        "data_pipe": [
                            {
                                "step": "convert",
                                "reader": {
                                    "type": "conll"
                                }
                            }
                        ],
                        "directory": "data/BC4CHEMD",
                        "train": [
                            "train.tsv"
                        ],
                        "validation": [
                            "devel.tsv"
                        ],
                        "test": [
                            "test.tsv"
                        ]
                    }
                }
            }
        },
        "format": {
